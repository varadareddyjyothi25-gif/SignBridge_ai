# SPARSHA (TOUCH) Environment Variables
# Copy this file to .env.local and populate with your Supabase project credentials.

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (found in Supabase Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Optional: Camera FPS limit (default: 30)
VITE_CAMERA_MAX_FPS=30

# Optional: ML Gesture Rejection Confidence Threshold (0.0 to 1.0, default 0.65)
VITE_GESTURE_CONFIDENCE_THRESHOLD=0.65
